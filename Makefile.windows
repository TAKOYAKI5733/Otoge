CXX      := g++
# 🌟 修正: -Dmain=SDL_main を削除。pkg-config --cflags sdl2 が
#          自動的にこの定義を含んでくれるため、二重定義を避ける
CXXFLAGS := -std=c++20 -Wall -Wextra -MMD -MP

SDL_CFLAGS    := $(shell pkg-config --cflags sdl2 SDL2_ttf SDL2_mixer)
SDL_LIBS      := $(shell pkg-config --libs sdl2 SDL2_ttf SDL2_mixer)
SDL_MAIN_LIBS := -lmingw32 -lSDL2main

SRC_DIR  := src
OBJ_DIR  := obj
BIN_DIR  := bin

TARGET   := $(BIN_DIR)/otoge.exe

SRCS     := $(wildcard $(SRC_DIR)/*.cpp) $(wildcard $(SRC_DIR)/imgui/*.cpp)
OBJS     := $(patsubst $(SRC_DIR)/%.cpp,$(OBJ_DIR)/%.o,$(SRCS))

DEPS     := $(OBJS:.o=.d)

ASSET_DIRS := sounds scores fonts

all: $(TARGET) copy_assets copy_dlls

# 🌟 修正: リンク時に CXXFLAGS を使わない(-Dmain=SDL_main がリンクコマンドに混ざるのを防ぐ)
$(TARGET): $(OBJS)
	@mkdir -p $(BIN_DIR)
	$(CXX) -std=c++20 $(SDL_MAIN_LIBS) $^ -o $@ $(SDL_LIBS) -mwindows

copy_assets:
	@mkdir -p $(BIN_DIR)
	@for dir in $(ASSET_DIRS); do \
	        if [ -d $$dir ]; then \
	            echo "Copying $$dir to $(BIN_DIR)/..."; \
	            cp -r $$dir $(BIN_DIR)/; \
	        fi; \
	    done

copy_dlls:
	@echo "Copying required DLLs to $(BIN_DIR)/..."
	@for dll in SDL2 SDL2_ttf SDL2_mixer libgcc_s_seh-1 libstdc++-6 libwinpthread-1; do \
	        if [ -f /ucrt64/bin/$$dll.dll ]; then \
	            cp /ucrt64/bin/$$dll.dll $(BIN_DIR)/; \
	        fi; \
	    done

$(OBJ_DIR)/%.o: $(SRC_DIR)/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -I$(SRC_DIR) -I$(SRC_DIR)/imgui $(SDL_CFLAGS) -c $< -o $@

clean:
	rm -rf $(OBJ_DIR) $(BIN_DIR)

-include $(DEPS)

.PHONY: all clean copy_assets copy_dlls