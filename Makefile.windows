CXX      := g++
CXXFLAGS := -std=c++20 -Wall -Wextra -MMD -MP

# SDL2_image を追加(GameCommon.h が SDL2/SDL_image.h を include しているため)
SDL_CFLAGS    := $(shell pkg-config --cflags sdl2 SDL2_image SDL2_ttf SDL2_mixer)
SDL_LIBS      := $(shell pkg-config --libs sdl2 SDL2_image SDL2_ttf SDL2_mixer)
SDL_MAIN_LIBS := -lmingw32 -lSDL2main

SRC_DIR  := src

# 🌟 Windows専用ビルドはUbuntu用(obj/, bin/)と完全に分離する
OBJ_DIR  := obj_w
BIN_DIR  := bin_w
DIST_DIR := dist/Otoge

TARGET   := $(BIN_DIR)/otoge.exe

SRCS     := $(wildcard $(SRC_DIR)/*.cpp) $(wildcard $(SRC_DIR)/imgui/*.cpp)
OBJS     := $(patsubst $(SRC_DIR)/%.cpp,$(OBJ_DIR)/%.o,$(SRCS))

DEPS     := $(OBJS:.o=.d)

ASSET_DIRS := sounds scores fonts

all: $(TARGET) copy_assets copy_dlls

$(TARGET): $(OBJS)
	@mkdir -p $(BIN_DIR)
	$(CXX) -std=c++20 $(SDL_MAIN_LIBS) $^ -o $@ $(SDL_LIBS) -lwinmm -mwindows

copy_assets:
	@mkdir -p $(BIN_DIR)
	@for dir in $(ASSET_DIRS); do \
	        if [ -d $$dir ]; then \
	            echo "Copying $$dir to $(BIN_DIR)/..."; \
	            cp -r $$dir $(BIN_DIR)/; \
	        fi; \
	    done

copy_dlls: $(TARGET)
	@echo "Copying required DLLs to $(BIN_DIR)/..."
	@ldd $(TARGET) | grep -i '/ucrt64/bin/' | awk '{print $$3}' | while read dll; do \
	        cp -u "$$dll" $(BIN_DIR)/; \
	    done

dist: all
	@echo "Building clean distribution directory..."
	@rm -rf $(DIST_DIR)
	@mkdir -p $(DIST_DIR)
	@cp -r $(BIN_DIR)/* $(DIST_DIR)/
	@echo "Distribution ready at $(DIST_DIR)/"

$(OBJ_DIR)/%.o: $(SRC_DIR)/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -I$(SRC_DIR) -I$(SRC_DIR)/imgui $(SDL_CFLAGS) -c $< -o $@

clean:
	rm -rf $(OBJ_DIR) $(BIN_DIR)

distclean: clean
	rm -rf dist

-include $(DEPS)

.PHONY: all clean distclean copy_assets copy_dlls dist